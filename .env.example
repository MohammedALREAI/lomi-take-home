# Copy to .env. Compose reads this file for LLM keys and model overrides.
# Extraction uses Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried when GEMINI_MODEL is still overloaded (HTTP 429/503) after
# its retries (about a minute of backoff). Leave empty to only retry.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite


# Used only when running packages outside Docker (tests, local dev).
DATABASE_URL=postgresql://app:app@localhost:5433/app
REDIS_URL=redis://localhost:6380
