# Copy to .env. Compose reads this file for LLM keys and model overrides.
# Set GEMINI_API_KEY (recommended) or ANTHROPIC_API_KEY. If both are set,
# Gemini is used unless LLM_PROVIDER=anthropic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Optional: tried when GEMINI_MODEL is still overloaded (HTTP 429/503) after
# its retries (about a minute of backoff). Leave empty to only retry.
GEMINI_FALLBACK_MODEL=

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Optional explicit provider selector: "gemini" | "anthropic"
LLM_PROVIDER=

# Used only when running packages outside Docker (tests, local dev).
DATABASE_URL=postgresql://app:app@localhost:5433/app
REDIS_URL=redis://localhost:6380
